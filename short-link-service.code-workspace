{
  // Metals がビルドルートを src/server として認識するよう、
  // Scala プロジェクトを先頭のフォルダに置いている。
  // リポジトリルート (.) は Makefile や docs/ を触るために併せて開く。
  "folders": [
    {
      "name": "server",
      "path": "src/server"
    },
    {
      "name": "front",
      "path": "src/front"
    },
    {
      "name": "tests",
      "path": "tests"
    },
    {
      "name": "repo-root",
      "path": "."
    }
  ],
  "settings": {
    "files.watcherExclude": {
      "**/target/**": true
    },

    // Metals に内蔵の Scalafmt で保存時整形する。設定は /app/.scalafmt.conf
    // routes や Twirl テンプレートには整形器が無いので scala のみに限定する
    "[scala]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "scalameta.metals"
    },

    // tests/ の TypeScript は整形が Prettier (/app/tests/.prettierrc)、
    // lint が oxlint (/app/tests/.oxlintrc.json)。フォーマットは Prettier 側にだけ任せる。
    // 他言語には影響させたくないので ts のみに限定する
    "[typescript]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.codeActionsOnSave": {
        "source.fixAll.oxc": "explicit"
      }
    },

    // front/ の React コンポーネント。Prettier は front/.prettierrc を読む。
    // front には oxlint を入れていないので整形だけ
    "[typescriptreact]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
  }
}
