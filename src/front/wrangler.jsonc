// Cloudflare Worker の設定。front の静的アセット (vite build の dist) を配り、
// /api/* と短縮 URL を Workers VPC の VPC Service (Cloudflare Tunnel → ECS の Play) に流す。コードは worker/。
//
//   make deploy-front ENV=develop   (リポジトリルートで。ビルドと Turnstile のサイトキー / シークレットの受け渡しもする)
//
// 認証情報は CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID (infra/.envrc.local)。
// Worker の名前は short-link-<env>。公開するのは env ごとのカスタムドメイン (u-na-gi.com のサブドメイン) だけで、
// workers.dev の URL は切る (Cloudflare Access をカスタムドメインにかけるので、別の入口を残さない)。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "short-link",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  // バージョンごとのプレビュー URL も Cloudflare Access の対象外になりうるので出さない
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 静的アセットより先に Worker を通す。先にアセットを見ると、短縮 URL (/{英数 8 文字}) の振り分けが効かない
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "develop": {
      "routes": [{ "pattern": "s-dev.u-na-gi.com", "custom_domain": true }],
      // Turnstile はかけない (staging / prod だけ)
      // IP ごとの回数制限。period は 10 か 60 秒だけ。namespace_id はアカウント内で一意な任意の数字
      // (データセンターごとのゆるい数え方なので、厳密な制限としては当てにしない)
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "REDIRECT_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      // service_id は infra/terraform/envs/develop の output vpc_service_id
      "vpc_services": [
        {
          "binding": "SERVER",
          "service_id": "01a0d36f-5f1f-71b1-8d72-736ca578ef7a",
        },
      ],
    },
    "staging": {
      "routes": [{ "pattern": "s-stg.u-na-gi.com", "custom_domain": true }],
      // 短縮と復元に Turnstile をかける。シークレットは make deploy-front が --secrets-file で入れる
      "vars": { "TURNSTILE": "on" },
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "REDIRECT_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      // service_id は infra/terraform/envs/staging の output vpc_service_id
      "vpc_services": [
        { "binding": "SERVER", "service_id": "01a0d3a1-865f-7c62-8489-8115a0711503" },
      ],
    },
    "prod": {
      "routes": [{ "pattern": "s.u-na-gi.com", "custom_domain": true }],
      // 短縮と復元に Turnstile をかける。シークレットは make deploy-front が --secrets-file で入れる
      "vars": { "TURNSTILE": "on" },
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "REDIRECT_LIMITER",
          "namespace_id": "3002",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      // service_id は infra/terraform/envs/prod の output vpc_service_id
      "vpc_services": [
        { "binding": "SERVER", "service_id": "01a0d3a1-d3eb-77f1-83ca-23eb3c168a38" },
      ],
    },
  },
}
