// Cloudflare Worker config. Serves the front end's static assets (dist from vite build) and
// sends /api/* and short URLs to the Workers VPC VPC Service (Cloudflare Tunnel → Play on ECS). The code is in worker/.
//
//   make deploy-front ENV=develop   (from the repository root. It also builds and passes the Turnstile site key / secret)
//
// Credentials are CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID (infra/.envrc.local).
// The Worker is named short-link-<env>. Only the per-env custom domain (a subdomain of u-na-gi.com) is public, and
// the workers.dev URL is turned off (Cloudflare Access is applied to the custom domain, so no other entry point is left).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "short-link",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  // Per-version preview URLs may also fall outside Cloudflare Access, so they are turned off
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Run the Worker before static assets. If assets are checked first, routing for short URLs (/{8 alphanumeric chars}) does not work
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "develop": {
      "routes": [{ "pattern": "s-dev.u-na-gi.com", "custom_domain": true }],
      // No Turnstile (staging / prod only)
      // Per-IP rate limits. period must be 10 or 60 seconds. namespace_id is any number unique within the account
      // (counting is loose and per data center, so do not rely on it as a strict limit)
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "REDIRECT_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      // service_id is output vpc_service_id of infra/terraform/envs/develop
      "vpc_services": [
        {
          "binding": "SERVER",
          "service_id": "01a0d36f-5f1f-71b1-8d72-736ca578ef7a",
        },
      ],
    },
    "staging": {
      "routes": [{ "pattern": "s-stg.u-na-gi.com", "custom_domain": true }],
      // Apply Turnstile to shorten and resolve. make deploy-front sets the secret with --secrets-file
      "vars": { "TURNSTILE": "on" },
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "REDIRECT_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      // service_id is output vpc_service_id of infra/terraform/envs/staging
      "vpc_services": [
        { "binding": "SERVER", "service_id": "01a0d3a1-865f-7c62-8489-8115a0711503" },
      ],
    },
    "prod": {
      "routes": [{ "pattern": "s.u-na-gi.com", "custom_domain": true }],
      // Apply Turnstile to shorten and resolve. make deploy-front sets the secret with --secrets-file
      "vars": { "TURNSTILE": "on" },
      "ratelimits": [
        { "name": "API_LIMITER", "namespace_id": "3001", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "REDIRECT_LIMITER",
          "namespace_id": "3002",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      // service_id is output vpc_service_id of infra/terraform/envs/prod
      "vpc_services": [
        { "binding": "SERVER", "service_id": "01a0d3a1-d3eb-77f1-83ca-23eb3c168a38" },
      ],
    },
  },
}
