# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()


GET     /api/v1/hello      controllers.HelloController.index()

# Cookie のセッションを持たない API なので CSRF の対象外にする。
# ブラウザは localhost の Cookie をポートを問わず送るため、付けないと別アプリの Cookie で 403 になりうる
+ nocsrf
POST    /api/v1/links       controllers.LinkController.create()

# 短縮URL。他のルートより後ろに置く
GET     /:code              controllers.LinkController.redirect(code: String)
