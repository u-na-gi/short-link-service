# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()
# Health check that also works through the front end (Vite / Cloudflare Worker). On the front end, GET / is index.html
GET     /api/v1/health              controllers.HomeController.index()


# This API has no cookie session, so exclude it from CSRF.
# Browsers send localhost cookies regardless of port, so without this, another app's cookies can cause a 403
+ nocsrf
POST    /api/v1/links       controllers.LinkController.create()
GET     /api/v1/links/resolve   controllers.LinkController.resolve(shortUrl: Option[String])

# Short URL. Keep it after the other routes
GET     /:code              controllers.LinkController.redirect(code: String)
