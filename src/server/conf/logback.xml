<?xml version="1.0" encoding="UTF-8" ?>

<!-- https://www.playframework.com/documentation/latest/SettingsLogger -->
<!-- Write one JSON line per event to stdout in both dev and production. In production, fields are searchable in CloudWatch Logs as-is.
     To read locally, pipe through jq (make logs-server). -->

<!DOCTYPE configuration>

<configuration>
  <import class="ch.qos.logback.classic.AsyncAppender"/>
  <import class="ch.qos.logback.core.ConsoleAppender"/>
  <import class="net.logstash.logback.encoder.LogstashEncoder"/>
  <import class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator"/>

  <appender name="STDOUT" class="ConsoleAppender">
    <encoder class="LogstashEncoder">
      <!-- Drop the context, or the application.home that Play puts in the logback context is added to every line -->
      <includeContext>false</includeContext>
      <!-- logging.LogMasking is responsible for hiding values (it lists only the keys that may be shown).
           This (decorator in 9.x, not jsonGeneratorDecorator) is a safety net for when a URL is passed to a log by mistake.
           Any string that looks like a URL with a scheme (xxx://...) is hidden, whatever the field name or depth, even inside the message.
           Masking by field name (url etc.) would also hide the URLs that LogMasking splits into parts (host, path), so match on the value. -->
      <decorator class="MaskingJsonGeneratorDecorator">
        <defaultMask>***</defaultMask>
        <value>(?i)[a-z][a-z0-9+.-]*://\S*</value>
      </decorator>
    </encoder>
  </appender>

  <appender name="ASYNCSTDOUT" class="AsyncAppender">
    <!-- By default INFO and below are dropped when the queue is busy; never drop, so access logs are not lost -->
    <discardingThreshold>0</discardingThreshold>
    <appender-ref ref="STDOUT"/>
  </appender>

  <logger name="play" level="INFO"/>
  <!-- logging.AccessLogFilter -->
  <logger name="access" level="INFO"/>
  <logger name="controllers" level="INFO"/>

  <root level="WARN">
    <appender-ref ref="ASYNCSTDOUT"/>
  </root>

</configuration>
