# syntax=docker/dockerfile:1
# For production (the image run on ECS). Separate from the development Dockerfile.
#
#   docker build --provenance=false --sbom=false -f Dockerfile.prod -t short-link-server .
#
# Pass --provenance=false --sbom=false when pushing to ECR. Without them BuildKit creates an image index with
# attestations, the tag goes on the index, and the actual image is untagged. The ECR lifecycle rule
# (delete untagged after 1 day) then deletes the actual image and breaks the tagged one.
#
# sbt stage (sbt-native-packager, bundled with Play) creates bin/ lib/ conf/ in target/universal/stage,
# and we put them on a JRE-only image. Dockerfile.prod.dockerignore decides what goes into the build context.

# Keep the JDK / sbt versions the same as the development Dockerfile
ARG JAVA_VERSION=21
ARG SBT_VERSION=1.13.0

# --- build --------------------------------------------------------------------
FROM eclipse-temurin:${JAVA_VERSION}-jdk-noble AS build

ARG SBT_VERSION

RUN curl -fsSL "https://github.com/sbt/sbt/releases/download/v${SBT_VERSION}/sbt-${SBT_VERSION}.tgz" \
        | tar xzf - -C /usr/share \
    && ln -s /usr/share/sbt/bin/sbt /usr/local/bin/sbt

WORKDIR /build

# Resolve dependencies first in a separate layer, so changing only sources does not re-download them
COPY build.sbt ./
COPY project/build.properties project/plugins.sbt project/
RUN sbt -batch update

COPY app app
COPY conf conf
RUN sbt -batch stage
# The start script is created as 0744. The owner stays root and it runs as the app user,
# so make it executable by everyone. The Windows .bat is not needed
RUN chmod 0755 target/universal/stage/bin/server \
    && rm target/universal/stage/bin/*.bat

# --- runtime ------------------------------------------------------------------
FROM eclipse-temurin:${JAVA_VERSION}-jre-noble

# Run as a dedicated user, not the official image's ubuntu user (uid 1000)
RUN groupadd --system app && useradd --system --gid app --no-create-home app

WORKDIR /opt/app
COPY --from=build --chown=root:root /build/target/universal/stage ./

USER app

EXPOSE 9000

# Size the JVM heap from the container memory limit
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75"

# Play writes RUNNING_PID on startup and refuses to start if it is left over. Not needed in a container, so disable it.
# play.http.secret.key is passed via the PLAY_HTTP_SECRET_KEY env var (conf/application.conf; injected from SSM on ECS)
CMD ["bin/server", "-Dpidfile.path=/dev/null"]
