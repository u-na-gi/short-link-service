{
  "name": "short-link-service",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/app",
  "remoteUser": "dev",

  // 9000 (Play) and 5173 (Vite) are published directly to the host by the root compose.yaml, so they are not forwarded here.
  // Forwarding them would compete for the same host ports

  // When docker compose is run from the devcontainer, bind mount sources are interpreted as host paths.
  // Pass the host-side workspace path so compose.yaml can mount using host paths
  "remoteEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },

  // Runs on the host before the container is created. If a bind mount source is missing on the host, Docker
  // creates it owned by root and it becomes unwritable from inside the container (gh auth's hosts.yml etc.).
  // ~/.gitconfig is a file, so create it empty if missing
  "initializeCommand": "mkdir -p \"$HOME/.config/gh\" \"$HOME/.ssh\" \"$HOME/.aws\" && touch \"$HOME/.gitconfig\"",

  // Create links to the CLIs in aqua.yaml. The actual binaries are downloaded on first run
  "postCreateCommand": "aqua i -l",

  // DooD (Docker outside of Docker): use the host's Docker daemon from inside the container
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "scalameta.metals",
        "esbenp.prettier-vscode",
        "oxc.oxc-vscode"
      ]
    }
  }
}
