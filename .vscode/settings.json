{
  "files.watcherExclude": {
    "**/target/**": true
  },

  // Format on save with Metals' built-in Scalafmt. Config is /app/.scalafmt.conf
  // routes and Twirl templates have no formatter, so limit this to scala
  "[scala]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "scalameta.metals"
  },

  // Show test run | debug in the editor (the default Test Explorer only shows them in the sidebar)
  "metals.testUserInterface": "Code Lenses"
}
